# IDE / editor config
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS / editor cruft
.DS_Store
Thumbs.db

# Logs
*.log

# Local web preview server artifacts (scripts/serve_flutter_web_fast.py)
server.pid

# Stray analysis / temp outputs
analysis_output*.txt
analyze_output*.txt
errors*.txt
lints*.txt

# Last-build ID (build artifact)
.last_build_id

# Runtime config with local API keys — DO NOT COMMIT
env-config.js
web/env-config.js

# Misc generated
*.pyc

# Play Store upload bundle — an 80 MB build output that is delivered through
# the Play Console, not through git (the app is rebuilt from this tree).
# The listing images under store/play/screenshots/ ARE tracked.
store/play/*.aab

# Stray macOS duplicate screenshots dropped at the repo root
/image copy*.png
