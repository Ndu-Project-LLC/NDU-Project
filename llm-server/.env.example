# Token the Firebase openaiProxy must send (Authorization: Bearer <token>).
# Generate a strong one with: openssl rand -hex 32
# The same value goes into the Firebase secret LLM_SERVER_API_TOKEN.
LLM_API_TOKEN=change-me

# Model served by Ollama. 7B Q4 comfortably fits the Always-Free ARM VM
# (4 OCPU / 24 GB RAM) and is a good quality/speed trade-off.
#
# Default: Hugging Face-sourced Qwen2.5-7B-Instruct (official GGUF, Q4_K_M).
# The HF_TOKEN below authenticates the pull from hf.co.
LLM_MODEL=hf.co/Qwen/Qwen2.5-7B-Instruct-GGUF:q4_k_m

# Hugging Face token — authenticates hf.co model pulls (needed for gated or
# private repos, and for reliable large-file downloads). Get one at
# https://huggingface.co/settings/tokens. NEVER commit the real value; this
# file is gitignored, keep it only in .env.
HF_TOKEN=change-me

# The project's custom model (llm-server/ndu-assistant.Modelfile, built on
# qwen2.5-coder:14b) is baked into the image and built automatically at boot:
#   LLM_MODEL=ndu-assistant:latest
# Other handy values:
#   LLM_MODEL=qwen2.5:7b-instruct        (Ollama library — no token needed)
#   LLM_MODEL=llama3.2:3b                (faster, weaker)
#   LLM_MODEL=hf.co/<owner>/<repo>:<tag> (any GGUF on Hugging Face)

# Optional: per-completion upstream timeout in milliseconds.
# LLM_TIMEOUT_MS=240000